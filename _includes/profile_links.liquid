<div class="profile-links">
  {% if site.data.socials.linkedin_username %}
    <a
      class="profile-link"
      href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}/"
      target="_blank"
      rel="noopener noreferrer"
    >
      <i class="fa-brands fa-linkedin"></i>
      LinkedIn
    </a>
  {% endif %}
  {% if site.data.socials.cv_pdf %}
    <a class="profile-link" href="{{ site.data.socials.cv_pdf | relative_url }}" target="_blank" rel="noopener noreferrer">
      <i class="fa-solid fa-file-lines"></i>
      CV
    </a>
  {% endif %}
  {% if site.data.socials.github_username %}
    <a
      class="profile-link"
      href="https://github.com/{{ site.data.socials.github_username }}"
      target="_blank"
      rel="noopener noreferrer"
    >
      <i class="fa-brands fa-github"></i>
      GitHub
    </a>
  {% endif %}
  {% if site.data.socials.scholar_userid %}
    <a
      class="profile-link"
      href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}"
      target="_blank"
      rel="noopener noreferrer"
    >
      <i class="ai ai-google-scholar"></i>
      Scholar
    </a>
  {% endif %}
</div>

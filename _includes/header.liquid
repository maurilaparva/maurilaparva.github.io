<header class="site-header">
  <nav id="navbar" role="navigation">
    <div class="container">
      {% comment %} The name is already set large in the page header on the about page {% endcomment %}
      {% if page.permalink != '/' %}
        <a class="site-brand" href="{{ '/' | relative_url }}">
          {% if site.title == 'blank' %}
            {{- site.first_name }} {{ site.last_name -}}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% else %}
        <span class="site-brand-placeholder"></span>
      {% endif %}

      <div class="site-nav">
        {% for page in site.pages %}
          {% if page.permalink == '/' %} {% assign about_title = page.title %} {% endif %}
        {% endfor %}

        <a class="site-nav-link {% if page.permalink == '/' %}active{% endif %}" href="{{ '/' | relative_url }}">
          {{- about_title -}}
        </a>

        {% assign sorted_pages = site.pages | sort: 'nav_order' %}
        {% for p in sorted_pages %}
          {% if p.nav and p.autogen == null and p.dropdown == null %}
            {% assign parent_link = p.permalink | remove: 'index.html' %}
            {%- if p.permalink contains '://' -%}
              {%- assign url = p.permalink -%}
            {%- elsif p.cv_pdf -%}
              {%- comment -%} Link straight to the PDF rather than the generated CV page {%- endcomment -%}
              {%- assign url = p.cv_pdf -%}
            {%- elsif p.permalink contains '/blog/' -%}
              {%- assign url = '/blog/' -%}
            {%- elsif p.permalink == '/news/' -%}
              {%- assign url = '/#news' -%}
            {%- elsif p.permalink == '/publications/' -%}
              {%- assign url = '/#publications' -%}
            {%- else -%}
              {%- assign url = p.url -%}
            {%- endif %}
            <a
              class="site-nav-link {% if page.url contains parent_link %}active{% endif %}"
              href="{{ url | relative_url }}"
              {% if p.cv_pdf %}target="_blank" rel="noopener noreferrer"{% endif %}
            >
              {{- p.title -}}
            </a>
          {% endif %}
        {% endfor %}

        {% if site.search_enabled %}
          <button id="search-toggle" title="Search" onclick="openSearchModal()">
            <i class="fa-solid fa-magnifying-glass"></i>
          </button>
        {% endif %}
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
